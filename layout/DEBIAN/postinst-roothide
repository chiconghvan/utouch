#!/bin/sh
# roothide postinst — uses jbroot command to resolve dynamic jailbreak root path

# Register app with SpringBoard
UICACHE=$(jbroot /usr/bin/uicache 2>/dev/null)
if [ -x "$UICACHE" ]; then
    "$UICACHE" -a
fi

# sudoers entry for zxtouchb
ZXTOUCHB=$(jbroot /usr/bin/zxtouchb)
SUDOERS_D=$(jbroot /etc/sudoers.d)
if [ -d "$SUDOERS_D" ]; then
    echo "mobile ALL=(root) NOPASSWD:$ZXTOUCHB" > "$SUDOERS_D/zxtouch"
    chmod 440 "$SUDOERS_D/zxtouch"
fi

# Create required app directories
mkdir -p /var/mobile/Library/ZXTouch/scripts/recording/
mkdir -p /var/mobile/Library/ZXTouch/config/tweak/
mkdir -p /var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/

REGISTRY=/var/mobile/Library/ZXTouch/config/tweak/script_registry.plist
# Remove example scripts installed by older package versions.
rm -rf /var/mobile/Library/ZXTouch/scripts/examples
rm -f "$REGISTRY"

# Patch add_datetime.sh shebang — roothide has no fixed /var/jb path
SH=$(jbroot /bin/sh)
SCRIPT=/var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/add_datetime.sh
cat > "$SCRIPT" << 'EOF'
#!/bin/sh
OUTPUT=/var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/output
DATE=$(jbroot /usr/bin/date 2>/dev/null)
if [ ! -x "$DATE" ]; then DATE=/usr/bin/date; fi
if [ ! -x "$DATE" ]; then DATE=/bin/date; fi
echo "$($DATE '+%m-%d-%Y %T'): Start running script. Script path: $1" >> "$OUTPUT"
while IFS= read -r line; do
    echo "$($DATE '+%m-%d-%Y %T'): $line" >> "$OUTPUT"
done
echo "$($DATE '+%m-%d-%Y %T'): Finish running script. Script path: $1" >> "$OUTPUT"
EOF
if [ -f "$SCRIPT" ]; then
    printf '#!%s\n' "$SH" > /tmp/adt_new.sh
    tail -n +2 "$SCRIPT" >> /tmp/adt_new.sh
    mv /tmp/adt_new.sh "$SCRIPT"
    chmod +x "$SCRIPT"
fi
touch /var/mobile/Library/ZXTouch/coreutils/ScriptRuntime/output
chown -R mobile:mobile /var/mobile/Library/ZXTouch

# Point $(jbroot)/usr/bin/python3 at the newest working Procursus Python we can
# find. We no longer ship a bundled Python 3.7 runtime — its libpython dylib
# lives under /usr/lib on stock iOS which doesn't exist on roothide, so it aborts
# at dyld load. Users must install python3 from Sileo (Procursus).
PYTHON3=$(jbroot /usr/bin/python3)
FOUND_PY=""
for PYVER in \
    "$(jbroot /usr/bin/python3.12)" \
    "$(jbroot /usr/bin/python3.11)" \
    "$(jbroot /usr/bin/python3.10)" \
    "$(jbroot /usr/bin/python3.9)" \
    "$(jbroot /usr/bin/python3.8)" \
    /usr/bin/python3 \
    /bin/python3; do
    if [ -x "$PYVER" ]; then
        ln -sf "$PYVER" "$PYTHON3"
        FOUND_PY="$PYVER"
        break
    fi
done
if [ -z "$FOUND_PY" ]; then
    echo "ZXTouch: warning — no working python3 found. Install one from Sileo (Procursus 'python3' package) before running .py scripts." >&2
fi

# Install zxtouch Python module into every installed Python's site/dist-packages
SRC=$(jbroot /usr/share/zxtouch/python/zxtouch)
LIBBASE=$(jbroot /usr/lib)
if [ -d "$SRC" ]; then
    for SP in "$LIBBASE"/python3*/site-packages "$LIBBASE"/python3*/dist-packages "$LIBBASE"/python3/dist-packages; do
        if [ -d "$SP" ]; then
            rm -rf "$SP/zxtouch"
            cp -R "$SRC" "$SP/" 2>/dev/null || true
        fi
    done
fi

# Re-sign app with roothide entitlements
APP=$(jbroot /Applications/zxtouch.app)
rm -f "$APP/embedded.mobileprovision"
cat > /tmp/zxtouch-ent.plist << 'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>platform-application</key><true/>
    <key>com.apple.private.skip-library-validation</key><true/>
    <key>com.apple.private.security.no-container</key><true/>
    <key>com.apple.private.security.no-sandbox</key><true/>
    <key>com.apple.private.security.storage.AppBundles</key><true/>
    <key>com.apple.private.security.storage.AppDataContainers</key><true/>
    <key>get-task-allow</key><true/>
    <key>application-identifier</key><string>com.zjx.zxtouch</string>
</dict>
</plist>
EOF
LDID=$(jbroot /usr/bin/ldid)
if [ -x "$LDID" ]; then
    "$LDID" -S/tmp/zxtouch-ent.plist "$APP/zxtouch"
fi

# launchd refuses to load any LaunchDaemon whose path chain is not root-owned
# / not group/world-writable, but dpkg preserves the build runner's uid/gid.
# Normalize the daemon path chain plus every plist/binary once, before any
# launchctl load below runs.
JBROOT_ROOT=$(jbroot 2>/dev/null || echo /var/jb)
for d in "$JBROOT_ROOT" "$JBROOT_ROOT/usr" "$JBROOT_ROOT/usr/bin" "$JBROOT_ROOT/Library" "$JBROOT_ROOT/Library/LaunchDaemons"; do
    [ -d "$d" ] || continue
    chown root:wheel "$d" 2>/dev/null || true
    chmod 0755 "$d" 2>/dev/null || true
done
LDAEMON_DIR="$JBROOT_ROOT/Library/LaunchDaemons"
if [ -n "$LDAEMON_DIR" ] && [ -d "$LDAEMON_DIR" ]; then
    chown root:wheel "$LDAEMON_DIR" 2>/dev/null || true
    chmod 0755 "$LDAEMON_DIR" 2>/dev/null || true
    for f in com.zjx.ocr.plist com.zjx.dashboard.plist com.zjx.trollvnc.plist; do
        [ -f "$LDAEMON_DIR/$f" ] || continue
        chown root:wheel "$LDAEMON_DIR/$f" 2>/dev/null || true
        chmod 0644 "$LDAEMON_DIR/$f" 2>/dev/null || true
    done
fi
for b in $(jbroot /usr/bin/zxtouch-ocrd 2>/dev/null) $(jbroot /usr/bin/zxtouch-dashboardd 2>/dev/null) $(jbroot /usr/bin/trollvncserver 2>/dev/null); do
    [ -f "$b" ] || continue
    chown root:wheel "$b" 2>/dev/null || true
    chmod 0755 "$b" 2>/dev/null || true
done

# TrollVNC bundled in the same .deb (single-.deb plan): VNC :5901 + noVNC :5801.
TVNC_BIN=$(jbroot /usr/bin/trollvncserver 2>/dev/null)
TVNC_PLIST=$(jbroot /Library/LaunchDaemons/com.zjx.trollvnc.plist 2>/dev/null)
if [ -n "$TVNC_BIN" ] && [ -x "$TVNC_BIN" ]; then
    # Roothide has no fixed /var/jb path: rewrite the bundled plist's
    # /var/jb prefix to the live jbroot before loading.
    JBROOT="${TVNC_BIN%/usr/bin/trollvncserver}"
    if [ -n "$TVNC_PLIST" ] && [ -f "$TVNC_PLIST" ] && [ "$JBROOT" != "/var/jb" ]; then
        sed -i "s|/var/jb|$JBROOT|g" "$TVNC_PLIST" 2>/dev/null || true
    fi
    if command -v launchctl >/dev/null 2>&1 && [ -n "$TVNC_PLIST" ]; then
        launchctl unload "$TVNC_PLIST" 2>/dev/null || true
        if ! launchctl load "$TVNC_PLIST" 2>>/var/mobile/Library/ZXTouch/trollvnc.log; then
            echo "ZXTouch: launchctl could not load TrollVNC; dashboard recovery will retry." >> /var/mobile/Library/ZXTouch/trollvnc.log
        fi
    fi
else
    echo "ZXTouch: warning — trollvncserver not found. Rebuild with tools/trollvnc/build-and-stage.sh for live-screen support." >&2
fi

# Standalone dashboard daemon (crash-isolated HTTP :8688). SpringBoard keeps a
# fallback on :8689 until this daemon binds after respring/reboot — the two hosts
# sit on separate ports so they can never fight over one.
DASH_BIN=$(jbroot /usr/bin/zxtouch-dashboardd 2>/dev/null)
DASH_PLIST=$(jbroot /Library/LaunchDaemons/com.zjx.dashboard.plist 2>/dev/null)
if [ -n "$DASH_BIN" ] && [ -x "$DASH_BIN" ]; then
    JBROOT="${DASH_BIN%/usr/bin/zxtouch-dashboardd}"
    if [ -n "$DASH_PLIST" ] && [ -f "$DASH_PLIST" ] && [ "$JBROOT" != "/var/jb" ]; then
        sed -i "s|/var/jb|$JBROOT|g" "$DASH_PLIST" 2>/dev/null || true
    fi
    if command -v launchctl >/dev/null 2>&1 && [ -n "$DASH_PLIST" ]; then
        launchctl unload "$DASH_PLIST" 2>/dev/null || true
        # `unload` is a no-op for a daemon launchd never managed (it can survive
        # a failed load or a respring outside the job). Such a copy predates
        # dashboardd.lock, so it would keep retrying to bind the port forever
        # next to the new instance. SIGTERM first so the daemon writes its
        # session-close marker and the upgrade does not look like a crash in
        # dashboard-debug.log; SIGKILL then guarantees a wedged copy cannot
        # survive next to the new instance.
        # killall via jbroot first (randomized prefix); stock fallback stays.
        KILLALL_BIN=$(jbroot /usr/bin/killall 2>/dev/null)
        if [ -n "$KILLALL_BIN" ] && [ -x "$KILLALL_BIN" ]; then
            "$KILLALL_BIN" zxtouch-dashboardd 2>/dev/null || true
            sleep 1
            "$KILLALL_BIN" -9 zxtouch-dashboardd 2>/dev/null || true
        else
            /usr/bin/killall zxtouch-dashboardd 2>/dev/null || killall zxtouch-dashboardd 2>/dev/null || true
            sleep 1
            /usr/bin/killall -9 zxtouch-dashboardd 2>/dev/null || killall -9 zxtouch-dashboardd 2>/dev/null || true
        fi
        if ! launchctl load "$DASH_PLIST" 2>>/var/mobile/Library/ZXTouch/dashboardd.log; then
            echo "ZXTouch: dashboard daemon load failed; SpringBoard fallback still serves :8689." >> /var/mobile/Library/ZXTouch/dashboardd.log
        fi
    fi
else
    echo "ZXTouch: warning — zxtouch-dashboardd not found. Dashboard stays SpringBoard-hosted." >&2
fi

# Dashboard debug log (:8688). The server writes this file itself, so only make
# sure it exists and belongs to `mobile` — the uid both hosts run as.
DASHBOARD_DEBUG_LOG=/var/mobile/Library/ZXTouch/dashboard-debug.log
touch "$DASHBOARD_DEBUG_LOG" 2>/dev/null || true
chown mobile:mobile "$DASHBOARD_DEBUG_LOG" 2>/dev/null || true
echo "ZXTouch: package installed" >> "$DASHBOARD_DEBUG_LOG" 2>/dev/null || true

OCR_BIN=$(jbroot /usr/bin/zxtouch-ocrd 2>/dev/null)
OCR_PLIST=$(jbroot /Library/LaunchDaemons/com.zjx.ocr.plist 2>/dev/null)
if [ -n "$OCR_BIN" ] && [ -x "$OCR_BIN" ] && [ -n "$OCR_PLIST" ] && [ -f "$OCR_PLIST" ]; then
    JBROOT="${OCR_BIN%/usr/bin/zxtouch-ocrd}"
    if [ "$JBROOT" != "/var/jb" ]; then sed -i "s|/var/jb|$JBROOT|g" "$OCR_PLIST" 2>/dev/null || true; fi
    chown root:wheel "$OCR_PLIST" "$OCR_BIN" 2>/dev/null || true
    chmod 0644 "$OCR_PLIST" 2>/dev/null || true
    chmod 0755 "$OCR_BIN" 2>/dev/null || true
    launchctl unload "$OCR_PLIST" 2>/dev/null || true
    if ! launchctl load "$OCR_PLIST" 2>>/var/mobile/Library/ZXTouch/ocrd.log; then
        echo "ZXTouch: OCR daemon launchd load failed after ownership normalization." >>/var/mobile/Library/ZXTouch/ocrd.log
    fi
fi

# Never restart SpringBoard from a maintainer script. Package managers run this
# inside the dpkg transaction, so a restart can kill their helper before dpkg
# records the package as configured. Sileo can offer a respring after dpkg exits.
exit 0
